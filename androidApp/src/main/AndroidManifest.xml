<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".QorApplication"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- A22 — Google Maps SDK key, sourced from local.properties (gitignored, per-checkout
             convention set up in this task) via the MAPS_API_KEY manifest placeholder in
             androidApp/build.gradle.kts. Empty in this environment: the Maps SDK does not crash
             on an empty/invalid key, it just fails to render tiles — EventDetailScreen's own
             EventMapState.Failed fallback covers the geocoding side of that gracefully. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A14 — shared event-detail deep link, see QorNavGraph.eventDetailDestination's KDoc
                 for why this is a custom scheme rather than a verified https App Link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="qualorock" android:host="evento" />
            </intent-filter>
        </activity>
    </application>

</manifest>
